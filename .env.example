# Copier ce fichier en .env et adapter les valeurs pour chaque environnement.
# En production (DJANGO_DEBUG=False), DJANGO_SECRET_KEY doit être une vraie
# valeur aléatoire — le logiciel refuse de démarrer sinon (voir config/settings.py).
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=rose
POSTGRES_USER=rose
POSTGRES_PASSWORD=change-moi
POSTGRES_HOST=db
POSTGRES_PORT=5432
