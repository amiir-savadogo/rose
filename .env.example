# Copier ce fichier en .env et adapter les valeurs pour chaque environnement.
# Ne JAMAIS committer le fichier .env (il est ignoré par git).
#
# En production (DJANGO_DEBUG=False), DJANGO_SECRET_KEY doit être une vraie valeur
# aléatoire d'au moins 32 caractères — le logiciel refuse de démarrer sinon (config/settings.py).
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=remplacez-par-une-cle-aleatoire-generee-avec-la-commande-ci-dessus
# True uniquement en développement local. En développement en HTTP (sans TLS), mettre aussi
# DJANGO_SECURE_COOKIES=False, sinon la connexion échoue (cookies réservés à HTTPS).
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rose.mon-institution.example
# DJANGO_SECURE_COOKIES=True
# Quand le site est servi en HTTPS : DJANGO_SSL_REDIRECT=True et DJANGO_HSTS_SECONDS=2592000
# DJANGO_SSL_REDIRECT=False
# DJANGO_HSTS_SECONDS=0

POSTGRES_DB=rose
POSTGRES_USER=rose
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-fort
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Premier compte administrateur, créé au démarrage SEULEMENT si le mot de passe est défini
# (12 caractères minimum, non trivial). Sans mot de passe : python manage.py createsuperuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
